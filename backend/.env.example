# Server Configuration
PORT=4000
NODE_ENV=development
LOG_LEVEL=info

# Database Configuration (Supabase Transaction Pooler URL recommended for Render)
# Format: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/hospital_db

# Authentication Secrets (Generate strong random secrets in production)
JWT_SECRET=your_jwt_access_secret_change_in_production_min_32_chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your_jwt_refresh_secret_change_in_production_min_32_chars
JWT_REFRESH_EXPIRES_IN=7d

# CORS Allowed Origin
CORS_ORIGIN=*

